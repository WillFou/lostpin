<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>7.0.0-alpha.1</Version>
    <UserSecretsId>lostpin-web-v7-development</UserSecretsId>
    <!-- Le frontend V6 reste a sa place. Seule cette liste est rendue publique. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../index.html" Link="wwwroot/index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/js/**/*.js" Exclude="../../src/js/**/config.js;../../src/js/**/*.local.js" Link="wwwroot/src/js/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/css/**/*.css" Link="wwwroot/src/css/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/**/*.jpg;../../assets/**/*.png;../../assets/**/*.svg;../../assets/**/*.webp;../../assets/**/*.woff2;../../assets/**/*.ico" Link="wwwroot/assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
