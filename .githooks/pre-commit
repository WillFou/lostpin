#!/bin/sh
# Optional local guard. Enable explicitly: git config core.hooksPath .githooks
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/dev/Test-Release.ps1 -Staged
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev/Test-Release.ps1 -Staged
else
  echo 'LostPin: PowerShell is required for the credential safety check.' >&2
  exit 1
fi
